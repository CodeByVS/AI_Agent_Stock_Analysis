# Alpha Vantage API Key (Optional - Recommended for live stock quotes, news, and historical data)
# Get a free key at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY="your_alpha_vantage_api_key_here"

# Hugging Face Inference API (Optional - Recommended for AI synthesis and news generation)
# If unconfigured, the application falls back to programmatic heuristic summarization.
# Get a token at: https://huggingface.co/settings/tokens
HF_API_KEY="your_hugging_face_token_here"


